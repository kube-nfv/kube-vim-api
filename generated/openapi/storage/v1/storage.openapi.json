{
  "components": {
    "parameters": {
      "Version": {
        "description": "API version requested by the consumer (SOL 013 9.4).",
        "in": "header",
        "name": "Version",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ProblemDetails": {
        "description": "Error details (SOL 013 6.3, RFC 9457).",
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri",
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.common.v1.OperationalState": {
        "description": "Operational state of a virtualised resource (IFA006).",
        "enum": [
          "OPERATIONAL_STATE_UNSPECIFIED",
          "OPERATIONAL_STATE_ENABLED",
          "OPERATIONAL_STATE_DISABLED"
        ],
        "type": "string"
      },
      "kubenfv.kubevim.common.v1.SnapshotStatus": {
        "description": "Status of a snapshot.\nValues may be added as snapshot support grows; clients should accept unknown values.",
        "enum": [
          "SNAPSHOT_STATUS_UNSPECIFIED",
          "SNAPSHOT_STATUS_CREATING",
          "SNAPSHOT_STATUS_READY",
          "SNAPSHOT_STATUS_FAILED"
        ],
        "type": "string"
      },
      "kubenfv.kubevim.common.v1.TypeOfStorage": {
        "description": "Type of a virtualised storage resource.\nValues may be added as Kubernetes storage support grows; clients should accept unknown values.",
        "enum": [
          "TYPE_OF_STORAGE_UNSPECIFIED",
          "TYPE_OF_STORAGE_VOLUME",
          "TYPE_OF_STORAGE_EPHEMERAL"
        ],
        "type": "string"
      },
      "kubenfv.kubevim.common.v1.VirtualStorageData": {
        "description": "Size, type and capabilities of a virtualised storage resource.",
        "properties": {
          "isBoot": {
            "description": "The software image is copied to this storage and the compute resource boots from it.",
            "type": "boolean"
          },
          "sizeOfStorage": {
            "description": "Size of the storage resource, in Kubernetes quantity format (e.g. \"20Gi\").",
            "type": "string"
          },
          "storageClass": {
            "description": "Kubernetes storage class of the storage, one labelled kubevim.kubenfv.io/storage=true; the VIM default when unset.",
            "type": "string"
          },
          "typeOfStorage": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.TypeOfStorage",
            "description": "Type of the storage resource."
          }
        },
        "required": [
          "typeOfStorage",
          "sizeOfStorage"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.common.v1.Volume": {
        "description": "A virtualised storage resource, e.g. a disk of a compute resource.",
        "properties": {
          "computeId": {
            "description": "Compute resource that uses the volume; empty when not attached.",
            "readOnly": true,
            "type": "string"
          },
          "hostId": {
            "description": "Host of the volume; empty for distributed storage.",
            "readOnly": true,
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Metadata set by the consumer and by the VIM; for keys under \"kubevim.kubenfv.io/\" that the VIM maintains, its value wins.",
            "type": "object"
          },
          "operationalState": {
            "allOf": [
              {
                "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.OperationalState"
              }
            ],
            "description": "Operational state of the volume.",
            "readOnly": true
          },
          "storageData": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.VirtualStorageData",
            "description": "Size, type and capabilities of the volume."
          },
          "volumeId": {
            "description": "Identifier of the volume: a UUID assigned by the VIM. Ephemeral disks of a compute\nresource are not resources of their own and use their disk name instead.",
            "readOnly": true,
            "type": "string"
          },
          "volumeName": {
            "description": "Name of the volume, given by the consumer; not unique.",
            "type": "string"
          },
          "zoneId": {
            "description": "Resource zone of the volume.",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "storageData"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.storage.v1.ListVolumeSnapshotsResponse": {
        "properties": {
          "nextpage_opaque_marker": {
            "description": "Marker of the next page; empty on the last page (SOL 013 5.4).",
            "type": "string"
          },
          "snapshots": {
            "description": "Snapshots matching the filter.",
            "items": {
              "$ref": "#/components/schemas/kubenfv.kubevim.storage.v1.VolumeSnapshot"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "kubenfv.kubevim.storage.v1.ListVolumesResponse": {
        "properties": {
          "nextpage_opaque_marker": {
            "description": "Marker of the next page; empty on the last page (SOL 013 5.4).",
            "type": "string"
          },
          "volumes": {
            "description": "Volumes matching the filter.",
            "items": {
              "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.Volume"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "kubenfv.kubevim.storage.v1.VolumeSnapshot": {
        "description": "A snapshot of a volume (Kubernetes VolumeSnapshot).",
        "properties": {
          "createdAt": {
            "description": "Time the snapshot was taken.",
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Metadata set by the consumer and by the VIM; for keys under \"kubevim.kubenfv.io/\" that the VIM maintains, its value wins.",
            "type": "object"
          },
          "snapshotId": {
            "description": "Identifier of the snapshot: a UUID assigned by the VIM.",
            "readOnly": true,
            "type": "string"
          },
          "snapshotName": {
            "description": "Name of the snapshot, given by the consumer; not unique.",
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.SnapshotStatus"
              }
            ],
            "description": "Status of the snapshot.",
            "readOnly": true
          },
          "volumeId": {
            "description": "Volume the snapshot was taken of. The snapshot is kept when the volume is deleted; the VIM\nthen sets the metadata key \"kubevim.kubenfv.io/source-deleted\" to \"true\".",
            "readOnly": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "kubenfv.kubevim.storage.v1.VolumeUpdate": {
        "description": "Changes to a volume: a patch. The name is replaced when set; metadata entries are merged.",
        "properties": {
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Metadata entries to add, or to overwrite when the key exists; keys not given are kept, and none is removed.",
            "type": "object"
          },
          "volumeName": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "oauth2": {
        "description": "OAuth 2.0 client credentials (SOL 013 8.3). The token URL is deployment specific.",
        "flows": {
          "clientCredentials": {
            "scopes": {
              "storage:v1:allocate": "Allocate volumes",
              "storage:v1:migrate": "Migrate volumes",
              "storage:v1:operate": "Snapshot volumes",
              "storage:v1:query": "Query volumes",
              "storage:v1:scale": "Resize volumes",
              "storage:v1:terminate": "Terminate volumes",
              "storage:v1:update": "Update volumes"
            },
            "tokenUrl": "https://idp.example.com/oauth2/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Kube-VIM virtualised storage API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/storage/v1/volumes": {
