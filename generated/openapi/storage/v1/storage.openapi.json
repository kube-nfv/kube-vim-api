      "post": {
        "operationId": "StorageService_CreateVolumeSnapshot",
        "parameters": [
          {
            "description": "Volume to take the snapshot of.",
            "in": "path",
            "name": "volume_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Version"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "requestId": {
                    "description": "Client-chosen UUID that makes the request idempotent (AIP-155).",
                    "type": "string"
                  },
                  "snapshot": {
                    "$ref": "#/components/schemas/kubenfv.kubevim.storage.v1.VolumeSnapshot",
