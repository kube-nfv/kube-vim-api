            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.Volume"
                }
              }
            },
            "description": "A virtualised storage resource, e.g. a disk of a compute resource.",
            "headers": {
              "Location": {
                "description": "URI of the created resource.",
                "schema": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "Version": {
                "description": "API version used (SOL 013 9.4).",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Error (SOL 013 6).",
            "headers": {
              "Version": {
                "description": "API version used (SOL 013 9.4).",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [
              "storage:v1:allocate"
            ]
          }
