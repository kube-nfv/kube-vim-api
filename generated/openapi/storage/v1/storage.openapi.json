{
  "components": {
    "parameters": {
      "Version": {
        "description": "API version requested by the consumer (SOL 013 9.4).",
        "in": "header",
        "name": "Version",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ProblemDetails": {
        "description": "Error details (SOL 013 6.3, RFC 9457).",
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri",
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.common.v1.AffinityGroup": {
        "description": "Producer-managed group of resources placed with affinity or anti-affinity.",
        "properties": {
          "groupId": {
            "description": "Identifier of the group: a UUID, the Kubernetes UID of the object behind it.",
            "readOnly": true,
            "type": "string"
          },
          "groupName": {
            "description": "Name of the group, given by the consumer.",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.AffinityScope",
            "description": "Scope of the group; NFVI node when unset."
          },
          "type": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.AffinityType",
            "description": "Affinity or anti-affinity."
          }
        },
        "required": [
          "groupName",
          "type"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.common.v1.AffinityOrAntiAffinityConstraint": {
        "description": "Affinity or anti-affinity of a resource being allocated with other resources. Only one of affinityOrAntiAffinityResourceList, affinityOrAntiAffinityResourceGroupId may be set.",
        "properties": {
          "affinityOrAntiAffinityResourceGroupId": {
            "description": "Identifier of an affinity group created with CreateAffinityGroup.",
            "type": "string"
          },
          "affinityOrAntiAffinityResourceList": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.AffinityOrAntiAffinityResourceList",
            "description": "Consumer-managed list of resource identifiers."
          },
          "scope": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.AffinityScope",
            "description": "Scope of the constraint; NFVI node when unset."
          },
          "type": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.AffinityType",
            "description": "Affinity or anti-affinity."
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.common.v1.AffinityOrAntiAffinityResourceList": {
        "description": "Consumer-managed list of resources (IFA006 8.4.8.3).",
        "properties": {
          "resourceId": {
            "description": "Identifiers of virtualised resources.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "resourceId"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.common.v1.AffinityScope": {
        "description": "Scope of an affinity or anti-affinity constraint (IFA006 8.4.8.2). Which\nvalues apply depends on the resource: compute uses NFVI_POP and NFVI_NODE;\nports add VIRTUAL_SWITCH_OR_ROUTER, PHYSICAL_NIC and PHYSICAL_NETWORK;\nnetworks use PHYSICAL_NIC, PHYSICAL_NETWORK and NFVI_NODE.",
        "enum": [
          "AFFINITY_SCOPE_UNSPECIFIED",
          "AFFINITY_SCOPE_NFVI_POP",
          "AFFINITY_SCOPE_NFVI_NODE",
          "AFFINITY_SCOPE_VIRTUAL_SWITCH_OR_ROUTER",
          "AFFINITY_SCOPE_PHYSICAL_NIC",
          "AFFINITY_SCOPE_PHYSICAL_NETWORK"
        ],
        "type": "string"
      },
      "kubenfv.kubevim.common.v1.AffinityType": {
        "description": "Affinity or anti-affinity.",
        "enum": [
          "AFFINITY_TYPE_UNSPECIFIED",
          "AFFINITY_TYPE_AFFINITY",
          "AFFINITY_TYPE_ANTI_AFFINITY"
        ],
        "type": "string"
      },
      "kubenfv.kubevim.common.v1.ListAffinityGroupsResponse": {
        "properties": {
          "affinityGroups": {
            "description": "Groups matching the filter.",
            "items": {
              "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.AffinityGroup"
            },
            "type": "array"
          },
          "nextpage_opaque_marker": {
            "description": "Marker of the next page; empty on the last page (SOL 013 5.4).",
            "type": "string"
          }
        },
        "type": "object"
      },
      "kubenfv.kubevim.common.v1.OperationalState": {
        "description": "Operational state of a virtualised resource (IFA006).",
        "enum": [
          "OPERATIONAL_STATE_UNSPECIFIED",
          "OPERATIONAL_STATE_ENABLED",
          "OPERATIONAL_STATE_DISABLED"
        ],
        "type": "string"
      },
      "kubenfv.kubevim.common.v1.TypeOfStorage": {
        "description": "Type of a virtualised storage resource.\nValues may be added as Kubernetes storage support grows; clients should accept unknown values.",
        "enum": [
          "TYPE_OF_STORAGE_UNSPECIFIED",
          "TYPE_OF_STORAGE_VOLUME",
          "TYPE_OF_STORAGE_EPHEMERAL"
        ],
        "type": "string"
      },
      "kubenfv.kubevim.common.v1.VirtualStorageData": {
        "description": "Size, type and capabilities of a virtualised storage resource.",
        "properties": {
          "isBoot": {
            "description": "The software image is copied to this storage and the compute resource boots from it.",
            "type": "boolean"
          },
          "sizeOfStorage": {
            "description": "Size of the storage resource, in Kubernetes quantity format (e.g. \"20Gi\").",
            "type": "string"
          },
          "typeOfStorage": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.TypeOfStorage",
            "description": "Type of the storage resource."
          }
        },
        "required": [
          "typeOfStorage",
          "sizeOfStorage"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.common.v1.Volume": {
        "description": "A virtualised storage resource, e.g. a disk of a compute resource.",
        "properties": {
          "computeId": {
            "description": "Compute resource that uses the volume; empty when not attached.",
            "readOnly": true,
            "type": "string"
          },
          "hostId": {
            "description": "Host of the volume; empty for distributed storage.",
            "readOnly": true,
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Metadata set by the consumer and by the VIM; for keys under \"kubevim.kubenfv.io/\" that the VIM maintains, its value wins.",
            "type": "object"
          },
          "operationalState": {
            "allOf": [
              {
                "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.OperationalState"
              }
            ],
            "description": "Operational state of the volume.",
            "readOnly": true
          },
          "storageData": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.VirtualStorageData",
            "description": "Size, type and capabilities of the volume."
          },
          "volumeId": {
            "description": "Identifier of the volume: a UUID assigned by the VIM. Ephemeral disks of a compute\nresource are not resources of their own and use their disk name instead.",
            "readOnly": true,
            "type": "string"
          },
          "volumeName": {
            "description": "Name of the volume, given by the consumer; not unique.",
            "type": "string"
          },
          "zoneId": {
            "description": "Resource zone of the volume.",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "storageData"
        ],
        "type": "object"
      },
      "kubenfv.kubevim.storage.v1.ListVolumesResponse": {
        "properties": {
          "nextpage_opaque_marker": {
            "description": "Marker of the next page; empty on the last page (SOL 013 5.4).",
            "type": "string"
          },
          "volumes": {
            "description": "Volumes matching the filter.",
            "items": {
              "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.Volume"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "kubenfv.kubevim.storage.v1.OperateVolumeResponse": {
        "properties": {
          "storageData": {
            "$ref": "#/components/schemas/kubenfv.kubevim.common.v1.Volume",
            "description": "Volume after the operation."
          },
          "storageOperationOutputData": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Operation results, e.g. \"snapshotId\" for CREATE_SNAPSHOT.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "kubenfv.kubevim.storage.v1.StorageOperation": {
        "description": "Operation on a volume (IFA006 7.5.1.6), realised with CSI volume snapshots.\nValues may be added as Kubernetes storage support grows; clients should accept unknown values.",
        "enum": [
          "STORAGE_OPERATION_UNSPECIFIED",
          "STORAGE_OPERATION_CREATE_SNAPSHOT",
          "STORAGE_OPERATION_REVERT_TO_SNAPSHOT",
          "STORAGE_OPERATION_DELETE_SNAPSHOT"
        ],
        "type": "string"
      },
      "kubenfv.kubevim.storage.v1.VolumeUpdate": {
        "description": "Changes to a volume. Each field that is set replaces the current value.",
        "properties": {
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Metadata entries to add or replace.",
            "type": "object"
          },
          "metadataKeysToRemove": {
            "description": "Metadata keys to remove.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "storageName": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "oauth2": {
        "description": "OAuth 2.0 client credentials (SOL 013 8.3). The token URL is deployment specific.",
        "flows": {
          "clientCredentials": {
            "scopes": {
              "storage:v1:allocate": "Allocate volumes",
              "storage:v1:migrate": "Migrate volumes",
              "storage:v1:operate": "Snapshot volumes",
              "storage:v1:query": "Query volumes",
              "storage:v1:scale": "Resize volumes",
              "storage:v1:terminate": "Terminate volumes",
              "storage:v1:update": "Update volumes"
            },
            "tokenUrl": "https://idp.example.com/oauth2/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
